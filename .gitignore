!data/interim/.gitkeep
!data/processed/.gitkeep

# Downloaded footage and its metadata stay local.
data/external/videos/**
!data/external/videos/.gitkeep

# Model artifacts are published separately on Hugging Face.
models/checkpoints/**
models/exported/**
models/reports/**
!models/checkpoints/.gitkeep
!models/checkpoints/README.md
!models/exported/.gitkeep
!models/reports/.gitkeep
